<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ash-run</AssemblyName>
    <RootNamespace>ASH.Runner</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- publish -r win-x64: self-contained single exe, no .NET install needed (same as AGV_FOTA_GATEWAY) -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(RuntimeIdentifier)' != ''">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASH.Core\ASH.Core.csproj" />
  </ItemGroup>

  <!-- public key the self-update verifies with (repo root, created by AshRelease keygen); absent = this build never updates itself -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\update-key.pub" LogicalName="update-key.pub" Condition="Exists('..\..\update-key.pub')" />
  </ItemGroup>

</Project>
