<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <!-- direct and at the highest version any package asks for: the plugin folder holds exactly one System.Memory, and a dll that was compiled against a newer one than the
         folder has cannot be satisfied by the plugin's assembly resolver (it only answers with equal or newer versions) -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ASH.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Export/Templates/*.txt" />
    <EmbeddedResource Include="Model/Templates/*.txt" />
  </ItemGroup>

</Project>
