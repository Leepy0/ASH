<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ASH.Server</AssemblyName>
    <RootNamespace>ASH.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- publish -r win-x64: self-contained single exe, no .NET install needed (same as AGV_FOTA_GATEWAY) -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(RuntimeIdentifier)' != ''">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASH.Core\ASH.Core.csproj" />
    <InternalsVisibleTo Include="ASH.Server.Tests" />
  </ItemGroup>

  <!-- public key the server verifies uploads with (repo root, created by AshRelease keygen); absent = unsigned uploads accepted with a warning -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\update-key.pub" LogicalName="update-key.pub" Condition="Exists('..\..\update-key.pub')" />
  </ItemGroup>

</Project>
