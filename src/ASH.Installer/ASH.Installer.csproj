<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyTitle>ASH 설치</AssemblyTitle>
    <Product>ASH - AGV Simul Helper</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- read by Program.SupportedVersion; same value as the plugin's ZwcadVersion metadata -->
    <AssemblyMetadata Include="ZwcadVersion" Value="$(AshZwcadVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: ASH.Core is loaded from the embedded copy (Program.Resolve), so the exe ships alone. -->
    <ProjectReference Include="..\ASH.Core\ASH.Core.csproj" Private="false" />
    <!-- build ordering only: the plugin output is embedded below -->
    <ProjectReference Include="..\ASH.Plugin\ASH.Plugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- the whole Plugin output (InstallPlanner.Files), so the installed Core and its dependencies match the Plugin they were built with -->
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\ASH.Plugin.dll" LogicalName="ASH.Plugin.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\ASH.Core.dll" LogicalName="ASH.Core.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\ClosedXML.dll" LogicalName="ClosedXML.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\DocumentFormat.OpenXml.dll" LogicalName="DocumentFormat.OpenXml.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\ExcelNumberFormat.dll" LogicalName="ExcelNumberFormat.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\Irony.dll" LogicalName="Irony.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\SixLabors.Fonts.dll" LogicalName="SixLabors.Fonts.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\System.Buffers.dll" LogicalName="System.Buffers.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\System.IO.Packaging.dll" LogicalName="System.IO.Packaging.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\System.Memory.dll" LogicalName="System.Memory.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\System.Numerics.Vectors.dll" LogicalName="System.Numerics.Vectors.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\System.Runtime.CompilerServices.Unsafe.dll" LogicalName="System.Runtime.CompilerServices.Unsafe.dll" />
    <EmbeddedResource Include="..\ASH.Plugin\bin\$(Configuration)\net48\XLParser.dll" LogicalName="XLParser.dll" />
  </ItemGroup>

</Project>
