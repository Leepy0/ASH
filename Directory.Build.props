<Project>
  <PropertyGroup>
    <Version>0.26.6</Version>
    <!-- ZWCAD year ASH.Plugin is built for (ZWCAD.NetApi 20.26.0 = ZWCAD 2026); the installer only installs into this version -->
    <AshZwcadVersion>2026</AshZwcadVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
